# Copy this file to `.env` and fill in the REAL values provided by the team /
# class services. NEVER commit `.env` — it is git-ignored. Keep this example
# with dummy values only.

# Chat / reasoning model (grounded answers, quiz writing) — OpenAI-compatible
DOBOLYI_CHAT_BASE=https://api.example.invalid/v1
DOBOLYI_CHAT_KEY=sk-dummy-change-me
DOBOLYI_CHAT_MODEL=example-chat-model

# Vision model (reads diagrams / charts in page images)
DOBOLYI_VISION_BASE=https://api.example.invalid/v1
DOBOLYI_VISION_KEY=sk-dummy-change-me
DOBOLYI_VISION_MODEL=example-vision-model

# Optional: local embedding model name (default: sentence-transformers/all-MiniLM-L6-v2)
#EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
